CREATE TABLE users (
    local_id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    remote_id INTEGER UNIQUE,
    name TEXT NOT NULL,
    email TEXT NOT NULL,
    gender TEXT NOT NULL,
    status TEXT NOT NULL,
    observed_at_epoch_ms INTEGER NOT NULL,
    server_position INTEGER
);

selectUsers:
SELECT *
FROM users
ORDER BY
    CASE WHEN server_position IS NULL THEN 0 ELSE 1 END,
    CASE WHEN server_position IS NULL THEN observed_at_epoch_ms END DESC,
    server_position ASC,
    name COLLATE NOCASE ASC;

selectUserByLocalId:
SELECT *
FROM users
WHERE local_id = ?;

selectRemoteUsers:
SELECT local_id, remote_id
FROM users
WHERE remote_id IS NOT NULL;

insertRemoteUserIfAbsent:
INSERT OR IGNORE INTO users (
    remote_id,
    name,
    email,
    gender,
    status,
    observed_at_epoch_ms,
    server_position
) VALUES (?, ?, ?, ?, ?, ?, ?);

updatePagedRemoteUser:
UPDATE users
SET
    name = ?,
    email = ?,
    gender = ?,
    status = ?,
    server_position = ?
WHERE remote_id = ? AND server_position IS NOT NULL;

updateLocallyCreatedUser:
UPDATE users
SET
    name = ?,
    email = ?,
    gender = ?,
    status = ?,
    server_position = ?
WHERE remote_id = ? AND server_position IS NULL;

deleteUser:
DELETE FROM users
WHERE local_id = ?;
